# MongoDB Connection Settings
MONGODB_URI="mongodb://localhost:27017/igen-architect"
MONGODB_USER="admin"
MONGODB_PASSWORD="your_password"
MONGODB_AUTH_SOURCE="admin"

# JWT Secrets for Authentication
# Generate strong random strings for production
JWT_ACCESS_SECRET="your_jwt_access_secret_change_me_in_production_key"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_change_me_in_production_key"

# Cloudinary Storage Configuration (replaces Firebase Storage)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Server Port and CORS Allowed Origins
PORT=3000
LINK_COR="http://localhost:3000,http://localhost:5173"

# Seed Super Admin Account Configuration
SUPERADMIN_EMAIL="
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=

# Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key"
APP_URL="http://localhost:3000"

# PiAPI Configuration
PIAPI_API_KEY=""
PIAPI_BASE_URL="https://api.piapi.ai/api/v1"
PIAPI_WEBHOOK_URL=""

# OpenRouter Configuration (test nano-banana 2)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Firebase Service Account Path (Only needed for data migration script)
# Path can be absolute or relative to project root
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
